DATABASE_URL="postgresql://postgres:Ar123456789@localhost:5432/thefinance?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Super Admin — use valores diferentes em produção
ADMIN_JWT_SECRET="admin-super-secret-jwt-key-change-in-production"
ADMIN_EMAIL="admin@thefinance.app"
ADMIN_PASSWORD="Admin@123456"

# Email — opção 1: Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="THE FINANCE <noreply@thefinance.app>"

# Email — opção 2: SMTP (Gmail, Brevo, Mailgun, etc.)
# Se RESEND_API_KEY estiver vazio, o sistema usa estas variáveis.
# Gmail: ative verificação em 2 etapas > gere "Senha de app" em myaccount.google.com
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""

# Segurança adicional
PASSWORD_RESET_SECRET="change-this-secret-in-production"

# Google Gemini AI (grátis — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS_PER_REQUEST=2000
AI_DEFAULT_MONTHLY_LIMIT_PRO=500000
AI_DEFAULT_MONTHLY_LIMIT_ENTERPRISE=0

# Supabase Storage (grátis — https://supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# iFood Integration
ENCRYPTION_KEY=
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_WEBHOOK_SECRET=
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_AUTO_CONFIRM_DELAY_MS=30000

# Evolution API (WhatsApp centralizado)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_aqui
EVOLUTION_INSTANCE=the-finance
EVOLUTION_SERVER_URL=https://seu-dominio.com
WHATSAPP_WEBHOOK_SECRET=secret_para_validar_webhook
WHATSAPP_RATE_LIMIT_PER_HOUR=10
